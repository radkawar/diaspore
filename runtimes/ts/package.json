{
  "name": "diaspore",
  "version": "0.3.1",
  "type": "module",
  "description": "Run Diaspore bundles (portable, sandboxed Python) in Node",
  "license": "MIT",
  "author": "radkawar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radkawar/diaspore.git",
    "directory": "runtimes/ts"
  },
  "homepage": "https://radkawar.github.io/diaspore",
  "bugs": {
    "url": "https://github.com/radkawar/diaspore/issues"
  },
  "keywords": ["diaspore", "python", "sandbox", "interpreter", "portable"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "diaspore-ts": "dist/cli.js"
  },
  "files": ["dist", "dspc.dsp.json.gz", "stdlib.dsps", "cpython/LICENSE", "cpython/UNICODE_LICENSE", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node scripts/prepack.mjs && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
